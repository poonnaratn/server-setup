# Username used to log in to the Fedora server.
SERVER_USER=your-server-user

# MagicDNS name or 100.x.y.z address from `tailscale status` on the server.
SERVER_TAILSCALE_HOST=fedora.tailnet-name.ts.net

# Public DNS name or public IP address. Leave blank if you use Tailscale only.
SERVER_PUBLIC_HOST=server.example.com

# Optional: change if sshd uses a non-default port.
SERVER_SSH_PORT=22

# Optional: absolute path to an SSH private key used for this server.
# SERVER_SSH_KEY=/Users/you/.ssh/fedora_server
